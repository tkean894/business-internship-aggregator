# PostgreSQL connection
DATABASE_URL=postgresql://user:password@localhost:5432/business_internships

# FastAPI
API_ENV=development
# Comma-separated list of origins allowed to call the API (CORS).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend (Next.js) — base URL of the FastAPI backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Clerk (authentication) — backend verifies session tokens independently
# against this JWKS URL; never trusts the frontend's auth state alone.
# JWKS URL is derived from your Clerk app's Frontend API domain (visible
# in the Clerk dashboard, or decode the publishable key's base64 body).
# Secret key is used only to look up a new user's email on first sign-in
# (backend/services/clerk_client.py) — never used to issue/verify tokens.
CLERK_JWKS_URL=https://your-app-name.clerk.accounts.dev/.well-known/jwks.json
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend (email) — used by backend/services/email.py and the
# notification job (backend/services/notifications.py). Without a
# verified sending domain, Resend's free tier only delivers to the
# account owner's own address — see docs/architecture.md "Email".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTIFICATIONS_FROM_EMAIL=onboarding@resend.dev
