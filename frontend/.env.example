# Base URL of the FastAPI backend. See ../.env.example / ../README.md.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Clerk (authentication). Publishable key is safe to expose in the
# browser by design (it identifies your Clerk app, not a secret).
# CLERK_SECRET_KEY is also required HERE, server-side in the Next.js
# app itself (used by middleware.ts / the auth() helper to verify
# sessions server-side before rendering) - this is a separate use of
# the same secret from the FastAPI backend's own copy (which only uses
# it for one-time email lookups via Clerk's Backend API - see
# backend/services/clerk_client.py). Never exposed to the browser
# either way; only NEXT_PUBLIC_-prefixed vars are.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
